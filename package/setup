#!/usr/bin/env bash
# rdev setup — install the AI development pipeline for your project
# Supports: Claude Code, Cursor, Codex CLI
set -euo pipefail

RDEV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="${1:-.}"
PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd)"

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

ok()   { echo -e "  ${GREEN}✓${NC} $1"; }
info() { echo -e "  ${BLUE}→${NC} $1"; }
warn() { echo -e "  ${YELLOW}!${NC} $1"; }

echo ""
echo "rdev — AI Development Pipeline Setup"
echo "═════════════════════════════════════"
echo ""
echo "Project: $PROJECT_DIR"
echo ""

# ─── Step 1: Generate process docs from canonical skills/ ────────────────
# Each skills/<name>/SKILL.md becomes docs/rdev/<name>.md (frontmatter stripped).
# README.md is copied verbatim as the pipeline entry-point doc.

info "Generating process docs to docs/rdev/"
mkdir -p "$PROJECT_DIR/docs/rdev"

strip_frontmatter() {
  # Drop the leading --- ... --- block, keep everything after.
  awk 'BEGIN { in_fm=0; done=0 }
       /^---$/ && !done { if (in_fm) { in_fm=0; done=1; next } else { in_fm=1; next } }
       in_fm { next }
       { print }' "$1"
}

count=0
for skill_dir in "$RDEV_DIR/skills"/*/; do
  name="$(basename "$skill_dir")"
  if [[ -f "$skill_dir/SKILL.md" ]]; then
    strip_frontmatter "$skill_dir/SKILL.md" > "$PROJECT_DIR/docs/rdev/$name.md"
    count=$((count + 1))
  fi
done

# Entry-point doc
cp "$RDEV_DIR/process/README.md" "$PROJECT_DIR/docs/rdev/README.md"
ok "Process docs installed ($count generated + README.md)"

# Copy QA context template if it doesn't exist
if [[ ! -f "$PROJECT_DIR/docs/rdev/qa-context.md" ]]; then
  if [[ -f "$RDEV_DIR/templates/qa-context.example.md" ]]; then
    cp "$RDEV_DIR/templates/qa-context.example.md" "$PROJECT_DIR/docs/rdev/qa-context.md"
    ok "QA context template installed (customize docs/rdev/qa-context.md for your app)"
  fi
fi

# ─── Step 2: Detect tools and install adapters ───────────────────────────

echo ""
echo "Detecting tools..."
echo ""

TOOLS_FOUND=0

# --- Claude Code ---
if command -v claude &>/dev/null; then
  TOOLS_FOUND=$((TOOLS_FOUND + 1))
  info "Claude Code detected"

  # Project-level skills + agents — copied from canonical package/skills and package/agents.
  # (Claude Code's .claude/ layout matches our canonical layout, so no transformation is needed.)
  mkdir -p "$PROJECT_DIR/.claude/skills" "$PROJECT_DIR/.claude/agents"
  cp -r "$RDEV_DIR/skills/"* "$PROJECT_DIR/.claude/skills/"
  cp "$RDEV_DIR/agents/"*.md "$PROJECT_DIR/.claude/agents/"
  ok "Claude Code skills installed (.claude/skills/)"
  ok "Claude Code agents installed (.claude/agents/)"

  # Also install user-level so it works outside this project
  if [[ -d "$HOME/.claude" ]]; then
    mkdir -p "$HOME/.claude/skills/rdev"
    cp -r "$RDEV_DIR/skills/"* "$HOME/.claude/skills/rdev/" 2>/dev/null || true
    ok "Claude Code user-level skills installed (~/.claude/skills/rdev/)"
  fi

  # Check for codex plugin (for cross-model review)
  if command -v codex &>/dev/null; then
    ok "Codex CLI found (cross-model review available)"
  else
    warn "Codex CLI not found — install for cross-model review:"
    echo "    npm install -g @openai/codex && codex login"
    echo "    claude plugin marketplace add openai/codex-plugin-cc"
    echo "    claude plugin install codex"
  fi
else
  warn "Claude Code not found (skipping)"
fi

# --- Cursor ---
if [[ -d "$PROJECT_DIR/.cursor" ]] || command -v cursor &>/dev/null; then
  TOOLS_FOUND=$((TOOLS_FOUND + 1))
  info "Cursor detected"

  mkdir -p "$PROJECT_DIR/.cursor/rules"
  cp "$RDEV_DIR/adapters/cursor/rules/rdev.md" "$PROJECT_DIR/.cursor/rules/"
  ok "Cursor rules installed (.cursor/rules/rdev.md)"
else
  # Check if there's a .cursorignore or other cursor files
  if ls "$PROJECT_DIR/.cursor"* &>/dev/null 2>&1; then
    TOOLS_FOUND=$((TOOLS_FOUND + 1))
    info "Cursor project detected"
    mkdir -p "$PROJECT_DIR/.cursor/rules"
    cp "$RDEV_DIR/adapters/cursor/rules/rdev.md" "$PROJECT_DIR/.cursor/rules/"
    ok "Cursor rules installed (.cursor/rules/rdev.md)"
  fi
fi

# --- Codex CLI ---
if command -v codex &>/dev/null; then
  TOOLS_FOUND=$((TOOLS_FOUND + 1))
  info "Codex CLI detected"

  mkdir -p "$PROJECT_DIR/.codex"
  cp "$RDEV_DIR/adapters/codex/instructions.md" "$PROJECT_DIR/.codex/"
  ok "Codex instructions installed (.codex/instructions.md)"
else
  # Skip silently — codex is optional
  true
fi

if [[ "$TOOLS_FOUND" -eq 0 ]]; then
  warn "No supported tools detected (Claude Code, Cursor, or Codex CLI)"
  echo "    Process docs are still installed at docs/rdev/"
  echo "    Point any AI tool at those files to use the pipeline"
fi

# ─── Step 3: Set up gitignore for state ──────────────────────────────────

echo ""
info "Setting up .gitignore for pipeline state"

# .rdev/ is where state lives (universal, not .claude/rdev/)
if ! grep -q "^\.rdev/" "$PROJECT_DIR/.gitignore" 2>/dev/null; then
  echo "" >> "$PROJECT_DIR/.gitignore"
  echo "# rdev pipeline state (personal, not shared)" >> "$PROJECT_DIR/.gitignore"
  echo ".rdev/" >> "$PROJECT_DIR/.gitignore"
  ok "Added .rdev/ to .gitignore"
else
  ok ".rdev/ already in .gitignore"
fi

# ─── Step 4: Add rdev section to project instructions ────────────────────

echo ""

# Check for CLAUDE.md
if [[ -f "$PROJECT_DIR/CLAUDE.md" ]]; then
  if ! grep -q "rdev" "$PROJECT_DIR/CLAUDE.md" 2>/dev/null; then
    info "Adding rdev section to CLAUDE.md"
    cat >> "$PROJECT_DIR/CLAUDE.md" << 'EOF'

## rdev — Development Pipeline

This project uses the rdev development pipeline. Process docs are in `docs/rdev/`.

Available commands: `/start`, `/build`, `/review`, `/ship`, `/fix-pr`, `/fix-ci`, `/qa`, `/status`

Run `/start <ticket-id>` to begin working on a ticket. See `docs/rdev/README.md` for full docs.
EOF
    ok "Added rdev section to CLAUDE.md"
  else
    ok "CLAUDE.md already mentions rdev"
  fi
fi

# ─── Summary ─────────────────────────────────────────────────────────────

echo ""
echo "═════════════════════════════════════"
echo -e "${GREEN}rdev installed!${NC}"
echo "═════════════════════════════════════"
echo ""
echo "  Process docs:  docs/rdev/"
[[ -d "$PROJECT_DIR/.claude/skills" ]] && echo "  Claude Code:   .claude/skills/ + .claude/agents/"
[[ -d "$PROJECT_DIR/.cursor/rules" ]] && echo "  Cursor:        .cursor/rules/rdev.md"
[[ -d "$PROJECT_DIR/.codex" ]] && echo "  Codex CLI:     .codex/instructions.md"
echo ""
echo "  State:         .rdev/ (gitignored)"
echo "  Plans:         docs/plans/<ticket>.md (committed)"
echo ""
echo "Usage:"
echo "  /start USENG-500        Start a ticket"
echo "  /build                  Build the plan"
echo "  /review                 Cross-model code review"
echo "  /ship                   Create PR + handle comments"
echo ""
echo "Commit the changes to share with your team:"
echo "  git add docs/rdev/ .claude/ .cursor/ .codex/ .gitignore CLAUDE.md"
echo "  git commit -m 'Add rdev AI development pipeline'"
echo ""
