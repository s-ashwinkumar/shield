#!/usr/bin/env bash
# shield install -- Provision the S.H.I.E.L.D. agent harness
set -euo pipefail

SHIELD_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/shield"
BIN_DIR="$HOME/.local/bin"
NON_INTERACTIVE=false

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

ok()   { echo -e "  ${GREEN}✓${NC} $1"; }
warn() { echo -e "  ${YELLOW}!${NC} $1"; }
fail() { echo -e "  ${RED}✗${NC} $1"; }
info() { echo -e "  ${BLUE}→${NC} $1"; }

# Parse args
while [[ $# -gt 0 ]]; do
  case "$1" in
    --defaults) NON_INTERACTIVE=true; shift ;;
    *) echo "Usage: ./install [--defaults]"; exit 1 ;;
  esac
done

echo ""
echo "S.H.I.E.L.D. -- agent harness setup"
echo "==================================="
echo ""

# ─── Prerequisites ───────────────────────────────────────────────────────────

echo "Checking prerequisites..."
echo ""

MISSING_REQUIRED=false

check_cmd() {
  local name="$1"
  local required="${2:-true}"
  local brew_pkg="${3:-}"
  local install_hint="${4:-}"

  if command -v "$name" &>/dev/null; then
    ok "$name"
    return 0
  fi

  if [[ "$required" == "true" ]]; then
    if [[ -n "$brew_pkg" ]] && command -v brew &>/dev/null; then
      warn "$name not found"
      if [[ "$NON_INTERACTIVE" == "true" ]]; then
        info "Installing $name..."
        brew install "$brew_pkg"
        ok "$name installed"
        return 0
      else
        read -rp "    Install $name via brew? [Y/n] " yn
        if [[ "$yn" != [nN] ]]; then
          brew install "$brew_pkg"
          ok "$name installed"
          return 0
        fi
      fi
    fi
    fail "$name not found${install_hint:+ -- $install_hint}"
    MISSING_REQUIRED=true
    return 1
  else
    warn "$name not found (optional)${install_hint:+ -- $install_hint}"
    return 1
  fi
}

# Check brew first (required, no auto-install)
if ! command -v brew &>/dev/null; then
  fail "brew not found -- install from https://brew.sh"
  MISSING_REQUIRED=true
else
  ok "brew"
fi

check_cmd git true git || true
check_cmd herdr true herdr "multiplexer the r* commands drive (then: herdr integration install claude)" || true
check_cmd jq true jq || true
check_cmd terminal-notifier true terminal-notifier "required for build/review/PR notifications" || true

# Claude Code is required
if command -v claude &>/dev/null; then
  ok "claude"
else
  fail "claude not found -- install Claude Code: https://code.claude.com"
  MISSING_REQUIRED=true
fi

# gh CLI for PR creation
check_cmd gh true "" "install from https://cli.github.com" || true

# docker (optional) -- only for repos that set CONTAINER in .shield/config
check_cmd docker false "" "only needed for repos that set CONTAINER in .shield/config" || true

echo ""

if [[ "$MISSING_REQUIRED" == "true" ]]; then
  echo -e "${RED}Missing required prerequisites. Fix the issues above and re-run.${NC}"
  exit 1
fi

# ─── Interactive Setup ───────────────────────────────────────────────────────

echo "Configuration"
echo "─────────────"
echo ""
echo "  shield works on any git repo: run it from inside the repo, or pass"
echo "  'shield -C <name>' to pick one under your projects root."
echo ""

DEFAULT_ROOT="$(dirname "$SHIELD_ROOT")"   # the dir this checkout lives in, e.g. ~/code

if [[ -f "$CONFIG_DIR/config" ]]; then
  ok "Keeping existing config at $CONFIG_DIR/config"
else
  if [[ "$NON_INTERACTIVE" == "true" ]]; then
    PROJECTS_ROOT="$DEFAULT_ROOT"
    DEFAULT_PROJECT=""
  else
    read -rp "  Projects root (where your repos live) [$DEFAULT_ROOT]: " PROJECTS_ROOT
    PROJECTS_ROOT="${PROJECTS_ROOT:-$DEFAULT_ROOT}"
    read -rp "  Default project when outside a repo (optional, name or path) []: " DEFAULT_PROJECT
  fi
  PROJECTS_ROOT="${PROJECTS_ROOT/#\~/$HOME}"
  DEFAULT_PROJECT="${DEFAULT_PROJECT/#\~/$HOME}"
  if [[ -n "$DEFAULT_PROJECT" && "$DEFAULT_PROJECT" != /* ]]; then
    DEFAULT_PROJECT="$PROJECTS_ROOT/$DEFAULT_PROJECT"
  fi

  info "Writing config to $CONFIG_DIR/config"
  mkdir -p "$CONFIG_DIR"
  sed \
    -e "s|{projects_root}|$PROJECTS_ROOT|g" \
    -e "s|{default_project}|$DEFAULT_PROJECT|g" \
    "$SHIELD_ROOT/config/config.example" > "$CONFIG_DIR/config"
  ok "Config written"
fi

echo ""

# ─── Link the shield command ─────────────────────────────────────────────────

info "Linking shield into $BIN_DIR"
mkdir -p "$BIN_DIR"
chmod +x "$SHIELD_ROOT"/bin/shield "$SHIELD_ROOT"/libexec/shield-*
# Drop links to commands this checkout no longer ships (shield is the only one).
for link in "$BIN_DIR"/*; do
  [[ -L "$link" ]] || continue
  target="$(readlink "$link")"
  if [[ "$target" == "$SHIELD_ROOT"/bin/* && ! -e "$target" ]]; then
    rm -f "$link"
    ok "Removed stale link $(basename "$link")"
  fi
done
ln -sf "$SHIELD_ROOT/bin/shield" "$BIN_DIR/shield"
ok "shield linked"

# ─── Ensure PATH ─────────────────────────────────────────────────────────────

SHELL_RC="$HOME/.zshrc"
if [[ "$(basename "$SHELL")" == "bash" ]]; then
  SHELL_RC="$HOME/.bashrc"
fi

if ! echo "$PATH" | tr ':' '\n' | grep -q "^$BIN_DIR$"; then
  if ! grep -qF "$BIN_DIR" "$SHELL_RC" 2>/dev/null; then
    info "Adding $BIN_DIR to PATH in $SHELL_RC"
    echo '' >> "$SHELL_RC"
    echo '# shield PATH' >> "$SHELL_RC"
    echo "export PATH=\"$BIN_DIR:\$PATH\"" >> "$SHELL_RC"
    ok "PATH updated (restart shell or: source $SHELL_RC)"
  else
    ok "PATH entry already exists in $SHELL_RC"
  fi
else
  ok "$BIN_DIR already in PATH"
fi

# ─── Verify agents directory ──────────────────────────────────────────────────

if [[ -d "$SHIELD_ROOT/agents" ]]; then
  agent_count=$(ls "$SHIELD_ROOT"/agents/*.md 2>/dev/null | wc -l | tr -d ' ')
  ok "Found $agent_count agent definitions (coordinator, builder, reviewer, coulson)"
else
  fail "agents/ directory not found in the shield repo"
fi

# ─── Trigger Notification Permission ─────────────────────────────────────────

if command -v terminal-notifier &>/dev/null; then
  info "Triggering notification permission prompt..."
  terminal-notifier -title "shield" -message "Setup complete! Notifications enabled." -sound default -group shield 2>/dev/null || true
  ok "Notification permission requested"
fi

# ─── Summary ─────────────────────────────────────────────────────────────────

echo ""
echo "════════════════════════════════════════"
echo -e "${GREEN}shield installed successfully!${NC}"
echo "════════════════════════════════════════"
echo ""
echo "  Config:     $CONFIG_DIR/config"
echo "  Command:    $BIN_DIR/shield"
echo "  Per-repo:   <repo>/.shield/config (optional — see $SHIELD_ROOT/config/project.example)"
echo ""
echo "Workflow (from inside a repo, or with -C <repo>):"
echo "  shield up                     # Create the repo's Herdr workspace"
echo "  shield stream ENG-492         # Create workstream, plan with agent"
echo "  shield build ENG-492          # Approve plan → autonomous build"
echo "  shield forward ENG-492        # Satisfied → code review loop"
echo "  shield resume ENG-492         # Resume completed stream for more work"
echo "  shield status --all           # See what's running, across repos"
echo "  shield clean ENG-492          # Clean up when done"
echo "  shield coulson                # One handler watching every stream"
echo ""
if ! echo "$PATH" | tr ':' '\n' | grep -q "^$BIN_DIR$"; then
  echo -e "${YELLOW}Note: Restart your shell or run: source $SHELL_RC${NC}"
  echo ""
fi
