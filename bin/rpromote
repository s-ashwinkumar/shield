#!/usr/bin/env bash
# rpromote -- point the single live server at a stream's worktree (herdr stack).
# Claims the local-server lease, then (re)starts `dev` in the 'services' tab with
# WORKSPACE_ROOT = the worktree, so the running app serves that stream's code.
# Worktrees never move; "promote" = repoint the live app. (tmux version: rtpromote)

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/_rdev_lib.sh"
rdev_load_config

usage() {
  cat <<EOF
Usage: rpromote <name>

Point the live server (the 'services' tab) at <name>'s worktree by restarting
\`dev\` with WORKSPACE_ROOT set to that worktree. Claims the local-server lease
first (fails if another stream holds it).

Arguments:
  name    Stream name (ticket ID)
EOF
  exit 0
}

NAME=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage ;;
    -*) echo "Unknown option: $1"; usage ;;
    *) NAME="$1"; shift ;;
  esac
done
[[ -z "$NAME" ]] && { echo "Error: stream name required"; usage; }

WORK_DIR="$(rdev_resolve_work_dir "$NAME")"
MODE=$(rdev_read_state "$NAME" | jq -r '.mode // "worktree"')
if [[ "$MODE" == "local" ]]; then
  echo "Stream '$NAME' is local mode — services already run with this code."
  exit 0
fi

# Claim the single-server lease (rlocal prints the holder + guidance on failure).
if ! "$SCRIPT_DIR/rlocal" claim "$NAME" --worktree "$WORK_DIR"; then
  exit 1
fi

echo "Pointing live server at worktree '$NAME'..."
rdev_serve "$(rdev_container_path "$WORK_DIR")"
rdev_update_state "$NAME" promoted true
echo ""
echo "Promoted: the 'services' tab now runs dev from '$NAME'."
echo "  Watch the services tab for startup; ports (3000/4000/8000) now serve this worktree."
echo "  Return to main + release the lease with: runpromote $NAME"
