#!/usr/bin/env bash
# rcaptain -- launch/ensure the first mate: rfleet watcher + coulson agent.
#
# Idempotent: run it any time. Ensures (1) the rfleet watcher daemon is
# running, (2) a 'captain' Herdr tab exists in the rdev workspace with a
# Claude session running the coulson agent (named rdev:coulson).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/_rdev_lib.sh"
rdev_load_config

ATT="${RFLEET_HOME:-$HOME/.rdev/attention}"
mkdir -p "$ATT"

# --- 1) Ensure rfleet under launchd (KeepAlive: survives shells, restarts on crash) ---
PLIST="$HOME/Library/LaunchAgents/com.shield.rfleet.plist"
LABEL="com.shield.rfleet"
if [[ ! -f "$PLIST" ]] || ! grep -q "$SCRIPT_DIR/rfleet" "$PLIST" 2>/dev/null; then
  mkdir -p "$HOME/Library/LaunchAgents"
  cat > "$PLIST" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$SCRIPT_DIR/rfleet</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>$ATT/rfleet.log</string>
  <key>StandardErrorPath</key><string>$ATT/rfleet.log</string>
</dict></plist>
PL
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  echo "rfleet: installed launchd service ($PLIST)"
fi
if launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; then
  :
else
  launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null || launchctl load "$PLIST" 2>/dev/null || true
fi
sleep 2
HB_AGE=999999
[[ -f "$ATT/heartbeat" ]] && HB_AGE=$(( $(date +%s) - $(stat -f %m "$ATT/heartbeat") ))
if (( HB_AGE < 60 )); then
  echo "rfleet: running under launchd (heartbeat ${HB_AGE}s ago)"
else
  launchctl kickstart -k "gui/$(id -u)/$LABEL" 2>/dev/null || true
  sleep 2
  [[ -f "$ATT/heartbeat" ]] && HB_AGE=$(( $(date +%s) - $(stat -f %m "$ATT/heartbeat") ))
  echo "rfleet: launchd kickstarted (heartbeat ${HB_AGE}s ago; log: $ATT/rfleet.log)"
fi

# --- 2) Ensure the coulson agent ---
CTAB="$(rdev-mux tab-find --name coulson 2>/dev/null || true)"
EXISTING=""
[[ -n "$CTAB" ]] && EXISTING="$(rdev-mux agent-tab --tab "$CTAB" 2>/dev/null || true)"
if [[ -n "$EXISTING" ]]; then
  echo "coulson: already running (pane $EXISTING)"
  echo ""
  echo "Talk to it in the 'captain' tab. Pending attention items:"
  ls "$ATT/pending" 2>/dev/null | grep -c '\.json$' || echo 0
  exit 0
fi

WS_ID="$(rdev-mux space-ensure --name "$RDEV_WORKSPACE" --cwd "$RHYTHMS_DIR")"
if [[ -z "$WS_ID" ]]; then
  echo "Error: no Herdr workspace '$RDEV_WORKSPACE'. Is the server running? (herdr status server)"
  exit 1
fi

TAB_ID="$(rdev-mux tab-find --name coulson --workspace "$WS_ID")"
if [[ -z "$TAB_ID" ]]; then
  TAB_ID="$(rdev-mux tab-new --name coulson --cwd "$RDEV_ROOT" --workspace "$WS_ID")"
fi
if [[ -z "$TAB_ID" ]]; then
  echo "Error: failed to create the coulson tab."
  exit 1
fi

P0="$(rdev-mux pane-first --tab "$TAB_ID")"
if [[ -z "$P0" ]]; then
  echo "Error: no pane in the coulson tab."
  exit 1
fi

CAPTAIN_CMD="claude --agent coulson --permission-mode auto -n rdev:coulson 'On duty. Check the attention queue (~/.rdev/attention/pending/) and the rfleet heartbeat, then give me a one-screen fleet status.'"
rdev-mux pane-run --pane "$P0" --text "$CAPTAIN_CMD" >/dev/null

echo "captain: launched in tab 'captain' (agent rdev:coulson)"
echo "Say things like: 'start USENG-1101' · 'what needs me?' · answers to items inline."
