#!/usr/bin/env bash
# rbuild -- Approve plan and start autonomous build

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/_rdev_lib.sh"
rdev_load_config

usage() {
  cat <<EOF
Usage: rbuild <name>

Approve the plan and tell the coordinator to start building autonomously.

Arguments:
  name    Stream name (ticket ID)

Options:
  --session <name>    tmux session (default: current session)
  -h, --help          Show this help
EOF
  exit 0
}

NAME=""
SESSION_FLAG=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage ;;
    --session) SESSION_FLAG="$2"; shift 2 ;;
    -*) echo "Unknown option: $1"; usage ;;
    *) NAME="$1"; shift ;;
  esac
done

if [[ -z "$NAME" ]]; then
  echo "Error: stream name required"
  usage
fi

rdev_resolve_session
WORK_DIR="$(rdev_resolve_work_dir "$NAME")"

# Validate state
STAGE=$(rdev_get_stage "$NAME")
if [[ "$STAGE" != "plan" ]]; then
  echo "Error: stream '$NAME' is in stage '$STAGE', expected 'plan'"
  echo "rbuild can only be run after planning is complete."
  exit 1
fi

# Check the Herdr tab exists
TAB_ID="$(rdev_stream_tab "$NAME")"
if [[ -z "$TAB_ID" ]]; then
  echo "Error: Herdr tab '$NAME' not found. Start it first: rstream $NAME"
  exit 1
fi

# Update state
rdev_update_state "$NAME" "stage" "build"

# Message the LIVE coordinator (mid-planning) to start building; Herdr shows blocked if it prompts.
rdev_coord_msg "$TAB_ID" "Plan approved. Start building. Read the plan from docs/plans/ and implement it with the builder subagent. When done, update .claude/rdev/state.json stage to ux_review."

echo "Build started for '$NAME'."
echo "You'll get a notification when it's done."
