#!/usr/bin/env bash
# rfocus -- focus a stream's herdr tab (and bring the hosting app forward).
#   rfocus <stream>
# Used as the click-action of rnotify notifications.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/_rdev_lib.sh"
rdev_load_config
set +e

[[ $# -lt 1 || "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { echo "Usage: rfocus <stream>"; exit 0; }
STREAM="$1"
WT="$WORKTREE_DIR/$STREAM"

TAB="$(jq -r '.herdr.tab // empty' "$WT/.claude/rdev/state.json" 2>/dev/null)"
if [[ -z "$TAB" ]]; then
  TAB="$("$SCRIPT_DIR/rdev-mux" list 2>/dev/null | jq -r --arg c "$WT" 'first(.result.agents[]|select(.cwd==$c)|.tab_id)//empty' 2>/dev/null)"
fi
[[ -n "$TAB" ]] && herdr tab focus "$TAB" >/dev/null 2>&1

# Bring the hosting app forward (set RDEV_TERMINAL_APP in ~/.rdev/config, e.g. "Herdr" / "Ghostty" / "iTerm")
APP="${RDEV_TERMINAL_APP:-}"
[[ -n "$APP" ]] && open -a "$APP" 2>/dev/null
exit 0
