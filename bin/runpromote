#!/usr/bin/env bash
# ⚠️ PARKED (2026-07-08): QA moved to Railway previews (see skills/parallel-testing.md).
#    Out of the active flow, pending fast local multi-port app servers. Kept for revival.
# runpromote -- return the live server to main and release the lease (herdr stack).
# Reverses rpromote: restarts `dev` with WORKSPACE_ROOT=main, releases the
# local-server lease. Worktrees never move. (tmux version: rtunpromote)

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/_rdev_lib.sh"
rdev_load_config

usage() {
  cat <<EOF
Usage: runpromote <name>

Return the live server (the 'services' tab) to main and release the local-server
lease held by <name>.

Arguments:
  name    Stream name (ticket ID) that currently holds the lease
EOF
  exit 0
}

NAME=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage ;;
    -*) echo "Unknown option: $1"; usage ;;
    *) NAME="$1"; shift ;;
  esac
done
[[ -z "$NAME" ]] && { echo "Error: stream name required"; usage; }

echo "Returning live server to main..."
rdev_serve /workspaces/rhythms
"$SCRIPT_DIR/rlocal" release "$NAME" || true
rdev_update_state "$NAME" promoted false
echo ""
echo "Unpromoted: the live server is back on main (WORKSPACE_ROOT=/workspaces/rhythms); lease released."
