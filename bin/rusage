#!/usr/bin/env python3
"""rusage -- Summarize Claude Code token usage across all sessions.

Reads the local transcripts (~/.claude/projects/*/*.jsonl), sums token usage,
and estimates the equivalent API cost. NOTE: on a subscription plan this is a
counterfactual ("what this would cost at API list prices"), not a bill.

Usage: rusage [--roles] [--days N]
"""

import json
import sys
from collections import defaultdict
from datetime import datetime, timedelta
from pathlib import Path

# API list prices per 1M tokens, by model family (input, output, cache_read, cache_write).
PRICING = {
    "opus":   {"input": 15.0, "output": 75.0, "cache_read": 1.5,  "cache_write": 18.75},
    "sonnet": {"input": 3.0,  "output": 15.0, "cache_read": 0.3,  "cache_write": 3.75},
    "haiku":  {"input": 1.0,  "output": 5.0,  "cache_read": 0.1,  "cache_write": 1.25},
}
DEFAULT_FAMILY = "opus"  # unknown/new models (e.g. fable/mythos) priced at opus rates


def model_family(model):
    m = (model or "").lower()
    for fam in ("opus", "sonnet", "haiku"):
        if fam in m:
            return fam
    return DEFAULT_FAMILY


def usage_cost(usage, model):
    p = PRICING[model_family(model)]
    return (
        usage.get("input_tokens", 0) / 1e6 * p["input"]
        + usage.get("output_tokens", 0) / 1e6 * p["output"]
        + usage.get("cache_read_input_tokens", 0) / 1e6 * p["cache_read"]
        + usage.get("cache_creation_input_tokens", 0) / 1e6 * p["cache_write"]
    )


def parse_session(filepath):
    """Parse one session JSONL: tokens, per-model cost, role signals."""
    first_ts = last_ts = None
    custom_title = slug = None
    agent_names = set()
    models = set()
    cwd = None
    tot = {"input": 0, "output": 0, "cache_read": 0, "cache_write": 0}
    cost = 0.0
    messages = 0

    with open(filepath, "r") as f:
        for line in f:
            try:
                entry = json.loads(line)
            except json.JSONDecodeError:
                continue

            ts = entry.get("timestamp")
            if ts:
                first_ts = first_ts or ts
                last_ts = ts
            if not custom_title and entry.get("customTitle"):
                custom_title = entry["customTitle"]
            if not slug and entry.get("slug"):
                slug = entry["slug"]
            if entry.get("agentName"):
                agent_names.add(entry["agentName"])
            if not cwd and entry.get("cwd"):
                cwd = entry["cwd"]

            msg = entry.get("message") or {}
            model = msg.get("model")
            if model and model != "<synthetic>":
                models.add(model)
            usage = msg.get("usage") if entry.get("type") == "assistant" else None
            if not usage:
                usage = entry.get("usage")
            if usage and isinstance(usage, dict):
                tot["input"] += usage.get("input_tokens", 0)
                tot["output"] += usage.get("output_tokens", 0)
                tot["cache_read"] += usage.get("cache_read_input_tokens", 0)
                tot["cache_write"] += usage.get("cache_creation_input_tokens", 0)
                cost += usage_cost(usage, model)
                messages += 1

    return {
        "project": filepath.parent.name,
        "name": custom_title or slug or "unnamed",
        "models": models,
        "agent_names": agent_names,
        "cwd": cwd or "",
        "first_ts": first_ts,
        "last_ts": last_ts,
        "input_tokens": tot["input"],
        "output_tokens": tot["output"],
        "cache_read": tot["cache_read"],
        "cache_write": tot["cache_write"],
        "cost": cost,
        "messages": messages,
    }


def role_of(s):
    """captain (harness overhead) / stream (ticket work) / other.

    Attribution keys, most reliable first: agentName recorded in the
    transcript, then the session title, then the project path (worktrees
    are per-stream project dirs).
    """
    if s["agent_names"] & {"coulson", "captain"} or s["name"] in ("rdev:coulson", "rdev:captain"):
        return "captain"
    if s["agent_names"] & {"coordinator", "coordinator-v1", "builder", "reviewer"}:
        return "stream"
    if "-worktrees-" in s["project"] or "/worktrees/" in s["cwd"]:
        return "stream"
    if "rdev:" in (s["name"] or ""):
        return "stream"
    return "other"


def fmt_tokens(n):
    if n >= 1_000_000:
        return f"{n/1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n/1_000:.1f}K"
    return str(n)


def fmt_cost(c):
    return f"${c:.2f}"


def group_line(label, group):
    g_in = sum(s["input_tokens"] for s in group)
    g_out = sum(s["output_tokens"] for s in group)
    g_cost = sum(s["cost"] for s in group)
    return f"  {label:<28} {len(group):>4} sess   in: {fmt_tokens(g_in):>8}   out: {fmt_tokens(g_out):>8}   cost: {fmt_cost(g_cost)}"


def main():
    args = sys.argv[1:]
    show_roles = "--roles" in args
    days_filter = None
    if "--days" in args:
        try:
            days_filter = int(args[args.index("--days") + 1])
        except (IndexError, ValueError):
            print("Usage: rusage [--roles] [--days N]")
            return

    projects_dir = Path.home() / ".claude" / "projects"
    all_files = [f for p in projects_dir.iterdir() if p.is_dir() for f in p.glob("*.jsonl")]
    if not all_files:
        print("No session logs found.")
        return

    print(f"Scanning {len(all_files)} sessions...\n")
    sessions = []
    for f in sorted(all_files):
        try:
            s = parse_session(f)
            if s["messages"] > 0:
                sessions.append(s)
        except Exception:
            pass

    if not sessions:
        print("No sessions with usage data found.")
        return

    sessions.sort(key=lambda s: s["first_ts"] or "")
    if days_filter is not None:
        cutoff_ts = (datetime.now() - timedelta(days=days_filter)).strftime("%Y-%m-%d")
        sessions = [s for s in sessions if (s["first_ts"] or "") >= cutoff_ts]
        if not sessions:
            print(f"No sessions in the last {days_filter} day(s).")
            return

    total_cost = sum(s["cost"] for s in sessions)
    all_models = sorted({m for s in sessions for m in s["models"]})

    print("=" * 70)
    print("CLAUDE CODE USAGE SUMMARY")
    print("=" * 70)
    print(f"  Sessions:        {len(sessions)}")
    if sessions[0]["first_ts"]:
        print(f"  Date range:      {sessions[0]['first_ts'][:10]} → {sessions[-1]['first_ts'][:10]}")
    print(f"  Input tokens:    {fmt_tokens(sum(s['input_tokens'] for s in sessions))}")
    print(f"  Output tokens:   {fmt_tokens(sum(s['output_tokens'] for s in sessions))}")
    print(f"  Cache read:      {fmt_tokens(sum(s['cache_read'] for s in sessions))}")
    print(f"  Cache write:     {fmt_tokens(sum(s['cache_write'] for s in sessions))}")
    print(f"  Models seen:     {', '.join(all_models) or 'unknown'}")
    print(f"  Est. API cost:   {fmt_cost(total_cost)}  (per-model list prices; on a")
    print(f"                   subscription this is counterfactual, NOT a bill)")
    print()

    if show_roles:
        print("-" * 70)
        print("ROLES: harness overhead vs work")
        print("-" * 70)
        by_role = defaultdict(list)
        for s in sessions:
            by_role[role_of(s)].append(s)
        for role, label in (("captain", "captain (harness overhead)"),
                            ("stream", "streams (ticket work)"),
                            ("other", "other sessions")):
            if by_role[role]:
                print(group_line(label, by_role[role]))
        cap_cost = sum(s["cost"] for s in by_role["captain"])
        work_cost = sum(s["cost"] for s in by_role["stream"])
        if cap_cost and work_cost:
            print(f"  overhead ratio: captain = {cap_cost / work_cost * 100:.1f}% of stream burn")
        print()

    daily = defaultdict(lambda: {"cost": 0.0, "input": 0, "output": 0, "sessions": 0})
    for s in sessions:
        if s["first_ts"]:
            d = daily[s["first_ts"][:10]]
            d["cost"] += s["cost"]
            d["input"] += s["input_tokens"]
            d["output"] += s["output_tokens"]
            d["sessions"] += 1

    print("-" * 70)
    print("DAILY USAGE (last 7 days)")
    print("-" * 70)
    print(f"  {'Date':<12} {'Sessions':>8} {'Input':>10} {'Output':>10} {'Est. Cost':>10}")
    print(f"  {'─'*12} {'─'*8} {'─'*10} {'─'*10} {'─'*10}")
    cutoff = (datetime.now() - timedelta(days=7)).strftime("%Y-%m-%d")
    for day in sorted(daily.keys()):
        if day >= cutoff:
            d = daily[day]
            print(f"  {day:<12} {d['sessions']:>8} {fmt_tokens(d['input']):>10} {fmt_tokens(d['output']):>10} {fmt_cost(d['cost']):>10}")
    print()

    print("-" * 70)
    print("TOP 10 SESSIONS BY OUTPUT")
    print("-" * 70)
    print(f"  {'Name':<34} {'Role':<8} {'Output':>8} {'Input':>8} {'Est. Cost':>10}")
    print(f"  {'─'*34} {'─'*8} {'─'*8} {'─'*8} {'─'*10}")
    for s in sorted(sessions, key=lambda x: -x["output_tokens"])[:10]:
        label = s["name"]
        if label in ("unnamed", None) or not label:
            label = s["project"].split("-")[-1]
        print(f"  {label[:34]:<34} {role_of(s):<8} {fmt_tokens(s['output_tokens']):>8} {fmt_tokens(s['input_tokens']):>8} {fmt_cost(s['cost']):>10}")


if __name__ == "__main__":
    main()
