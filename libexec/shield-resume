#!/usr/bin/env bash
# shield resume -- Resume work on a completed or paused stream

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/_lib.sh"
shield_load_config

usage() {
  cat <<EOF
Usage: shield [-C <project>] resume <name> [options]

Resume work on a stream that was previously completed or paused.
Preserves existing state, plan, and review history.

Arguments:
  name    Stream name (ticket ID or custom name)

Options:
  --from <stage>      Stage to resume from (default: build)
                      Stages: plan, build, code_review, pr_comments
  --pr <number>       PR number (to find the branch if state is missing)
  -r, --runner <cmd>  Agent CLI to drive the stream (default: the stream's
                      recorded runner from state.json, else claude). Passing a
                      different runner here IS the switch mechanism (see shield switch).
  --local             Work on main repo (default if no worktree exists)
  --worktree          Work in a worktree
  --god               Run fully autonomous after resuming
  -h, --help          Show this help
EOF
  exit 0
}

NAME=""
FROM_STAGE="build"
PR_NUMBER=""
GOD=false
RUNNER_FLAG=
MODE_FLAG=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage ;;
    --from) FROM_STAGE="$2"; shift 2 ;;
    --pr) PR_NUMBER="$2"; shift 2 ;;
    --local) MODE_FLAG="local"; shift ;;
    --worktree) MODE_FLAG="worktree"; shift ;;
    --god) GOD=true; shift ;;
    -r|--runner) RUNNER_FLAG="$2"; shift 2 ;;
    -*) echo "Unknown option: $1"; usage ;;
    *) NAME="$1"; shift ;;
  esac
done

if [[ -z "$NAME" ]]; then
  echo "Error: stream name required"
  usage
fi

# Validate stage
case "$FROM_STAGE" in
  plan|build|code_review|pr_comments) ;;
  *) echo "Error: invalid stage '$FROM_STAGE'. Must be: plan, build, code_review, pr_comments"; exit 1 ;;
esac

shield_ensure_session

# --- Find the project, work directory and branch ---

shield_resolve_stream "$NAME"
STATE_FILE="$WORK_DIR/$SHIELD_STATE_REL/state.json"

if [[ -f "$STATE_FILE" ]]; then
  # Existing state found
  STATE=$(cat "$STATE_FILE")
  EXISTING_MODE=$(echo "$STATE" | jq -r '.mode // "worktree"')
  TICKET=$(echo "$STATE" | jq -r '.ticket // ""')
  OLD_STAGE=$(echo "$STATE" | jq -r '.stage // "unknown"')
  BRANCH=$(git -C "$WORK_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
  echo "Found existing stream '$NAME' (stage: $OLD_STAGE, branch: $BRANCH, mode: $EXISTING_MODE)"

  # If user explicitly wants a different mode, switch to the no-state path
  if [[ -n "$MODE_FLAG" && "$MODE_FLAG" != "$EXISTING_MODE" ]]; then
    echo "Switching from $EXISTING_MODE to $MODE_FLAG mode..."
    # Keep ticket info but clear state so the no-state path reinitializes
    TICKET=${TICKET:-$NAME}
    rm -f "$STATE_FILE"
    STATE_FILE=""
  fi
fi

if [[ -z "$STATE_FILE" ]] || [[ ! -f "$STATE_FILE" ]]; then
  # No state — try to find branch from PR or by name
  BRANCH=""
  if [[ -n "$PR_NUMBER" ]]; then
    BRANCH=$(gh pr view "$PR_NUMBER" --json headRefName -q .headRefName 2>/dev/null || echo "")
    TICKET=$(echo "$NAME" | tr '[:lower:]' '[:upper:]')
    if [[ -z "$BRANCH" ]]; then
      echo "Error: could not find PR #$PR_NUMBER"
      exit 1
    fi
    echo "Found PR #$PR_NUMBER on branch '$BRANCH'"
  else
    # Try common branch patterns
    TICKET_LOWER=$(echo "$NAME" | tr '[:upper:]' '[:lower:]')
    for pattern in "$NAME" "stream/$NAME" "$TICKET_LOWER"; do
      if git -C "$PROJECT_DIR" show-ref --verify --quiet "refs/heads/$pattern" 2>/dev/null; then
        BRANCH="$pattern"
        break
      fi
      if git -C "$PROJECT_DIR" show-ref --verify --quiet "refs/remotes/origin/$pattern" 2>/dev/null; then
        BRANCH="$pattern"
        break
      fi
    done

    # If not found, search for branches containing the ticket ID (e.g. someone/eng-582-feature-name)
    if [[ -z "$BRANCH" ]]; then
      MATCH=$(git -C "$PROJECT_DIR" branch -a 2>/dev/null | grep -i "$TICKET_LOWER" | head -1 | sed 's/^[ *+]*//' | sed 's|remotes/origin/||')
      if [[ -n "$MATCH" ]]; then
        BRANCH="$MATCH"
      fi
    fi

    if [[ -z "$BRANCH" ]]; then
      echo "Error: could not find branch for '$NAME'. Use --pr <number> to find it from a PR."
      exit 1
    fi
    TICKET="$NAME"
    echo "Found branch '$BRANCH'"
  fi

  # Determine mode: explicit flag > existing worktree > default to local
  if [[ "$MODE_FLAG" == "worktree" ]]; then
    MODE="worktree"
  elif [[ "$MODE_FLAG" == "local" ]]; then
    MODE="local"
  elif [[ -d "$WORKTREE_DIR/$NAME" ]]; then
    MODE="worktree"
    echo "Found existing worktree at $WORKTREE_DIR/$NAME"
  else
    MODE="local"
  fi

  if [[ "$MODE" == "worktree" ]]; then
    WORK_DIR="$WORKTREE_DIR/$NAME"
    if [[ ! -d "$WORK_DIR" ]]; then
      mkdir -p "$WORKTREE_DIR"

      # If the branch is checked out in the main repo, switch main repo to the base first
      MAIN_BRANCH=$(git -C "$PROJECT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
      if [[ "$MAIN_BRANCH" == "$BRANCH" ]]; then
        echo "Branch '$BRANCH' is checked out in main repo. Switching main repo to $BASE_BRANCH..."
        git -C "$PROJECT_DIR" checkout "$BASE_BRANCH"
      fi

      # If the branch is locked to another worktree, remove it first
      WT_PATH=$(git -C "$PROJECT_DIR" worktree list --porcelain 2>/dev/null | grep -B2 "branch refs/heads/$BRANCH" | grep "^worktree " | sed 's/^worktree //' || true)
      if [[ -n "$WT_PATH" && "$WT_PATH" != "$PROJECT_DIR" && "$WT_PATH" != "$WORK_DIR" ]]; then
        echo "Branch '$BRANCH' is used by worktree at $WT_PATH. Removing..."
        git -C "$PROJECT_DIR" worktree remove "$WT_PATH" --force 2>/dev/null || rm -rf "$WT_PATH"
        git -C "$PROJECT_DIR" worktree prune
      fi

      echo "Creating worktree '$NAME' on branch '$BRANCH'..."
      if git -C "$PROJECT_DIR" show-ref --verify --quiet "refs/heads/$BRANCH" 2>/dev/null; then
        git -C "$PROJECT_DIR" worktree add "$WORK_DIR" "$BRANCH"
      else
        git -C "$PROJECT_DIR" worktree add "$WORK_DIR" -b "$BRANCH" "origin/$BRANCH"
      fi
    fi

    shield_copy_files "$WORK_DIR"

    # Symlink docs/plans/ to main repo so plans survive worktree cleanup
    if [[ ! -e "$WORK_DIR/docs/plans" ]]; then
      mkdir -p "$PROJECT_DIR/docs/plans" "$WORK_DIR/docs"
      ln -sf "$PROJECT_DIR/docs/plans" "$WORK_DIR/docs/plans"
      echo "Symlinked docs/plans/ to main repo"
    fi
  else
    WORK_DIR="$PROJECT_DIR"
  fi

  # Checkout the branch (local mode only — worktree is already on the right branch)
  if [[ "$MODE" == "local" ]]; then
    CURRENT_BRANCH=$(git -C "$WORK_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
    if [[ "$CURRENT_BRANCH" != "$BRANCH" ]]; then
      if ! git -C "$PROJECT_DIR" diff --quiet 2>/dev/null || ! git -C "$PROJECT_DIR" diff --cached --quiet 2>/dev/null; then
        echo "Warning: main repo has uncommitted changes."
        read -rp "Stash them and continue? [Y/n] " confirm
        if [[ "$confirm" == [nN] ]]; then
          echo "Aborted."
          exit 1
        fi
        git -C "$PROJECT_DIR" stash push -m "shield: auto-stash before resume $NAME"
      fi

      # Checkout — create local tracking branch if needed
      if git -C "$PROJECT_DIR" show-ref --verify --quiet "refs/heads/$BRANCH" 2>/dev/null; then
        git -C "$PROJECT_DIR" checkout "$BRANCH"
      else
        git -C "$PROJECT_DIR" checkout -b "$BRANCH" "origin/$BRANCH"
      fi
    fi
  fi

  # Initialize state
  shield_init_state_at "$WORK_DIR" "$NAME" "$TICKET" "$MODE" false "$GOD" "$FROM_STAGE"

  # Create ticket file if missing
  TICKET_FILE="$WORK_DIR/$SHIELD_STATE_REL/$NAME.md"
  if [[ ! -f "$TICKET_FILE" ]]; then
    echo "# $TICKET" > "$TICKET_FILE"
    echo "" >> "$TICKET_FILE"
    echo "Resumed from existing branch. Ticket context will be fetched by the coordinator." >> "$TICKET_FILE"
  fi

  mkdir -p "$WORK_DIR/docs/plans"
  echo "Initialized state at stage '$FROM_STAGE'"
fi

# --- Update state to the requested stage ---

STATE_FILE="$WORK_DIR/$SHIELD_STATE_REL/state.json"
shield_register_stream "$NAME" "$WORK_DIR"
shield_git_exclude
if [[ -f "$STATE_FILE" ]]; then
  # Update stage
  tmp=$(jq --arg s "$FROM_STAGE" '.stage = $s' "$STATE_FILE")
  if [[ "$GOD" == "true" ]]; then
    tmp=$(echo "$tmp" | jq '.god_mode = true')
  fi
  tmp=$(echo "$tmp" | jq --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '.resumed_at = $t')
  echo "$tmp" > "$STATE_FILE"
  echo "State reset to stage '$FROM_STAGE'"
fi

# --- Refresh agents, skills, playbook and project facts ---

shield_install_agents "$WORK_DIR"
"$SCRIPT_DIR/shield-sync-skills" "$PROJECT_DIR" || echo "sync-skills failed (non-fatal)"
shield_install_playbook "$WORK_DIR"
[[ -f "$STATE_FILE" ]] && shield_state_project_meta "$STATE_FILE"
echo "Refreshed agents + workflow playbook"

# --- Find-or-create the Herdr tab in the project workspace ---
WS_ID="$(mux space-ensure --name "$WORKSPACE" --cwd "$PROJECT_DIR")"
TAB_ID=""
[[ -n "$WS_ID" ]] && TAB_ID="$(mux tab-find --name "$NAME" --workspace "$WS_ID")"
TAB_CREATED=false
if [[ -z "$TAB_ID" ]]; then
  TAB_ID="$(mux tab-new --name "$NAME" --cwd "$WORK_DIR" --workspace "$WS_ID")"
  TAB_CREATED=true
fi
if [[ -z "$TAB_ID" ]]; then
  echo "Error: failed to create Herdr tab for '$NAME' (herdr server running?)"
  exit 1
fi

# Permission mode
PERM_FLAG="--permission-mode auto"
if [[ "$GOD" == "true" ]]; then
  PERM_FLAG="--dangerously-skip-permissions"
fi

# Launch coordinator in the LEFT pane — fresh session (resuming from a new point).
P0="$(mux pane-first --tab "$TAB_ID")"
if [[ -n "$P0" ]]; then
  if [[ "$TAB_CREATED" == "true" ]]; then
    mux pane-split --pane "$P0" --dir right --ratio 0.7 --cwd "$WORK_DIR" >/dev/null 2>&1 || true
  fi
  # FOOTGUN GUARD: never type a launch command into a pane that holds a LIVE
  # agent — it lands as chat input in the running session and wrecks it.
  LIVE_PANE="$(mux agent-cwd --cwd "$WORK_DIR" 2>/dev/null || true)"
  if [[ -n "$LIVE_PANE" ]]; then
    echo "Stream '$NAME' already has a LIVE agent (pane $LIVE_PANE)."
    echo "Not launching a second one. To talk to it, type in its pane (or: shield send $NAME <msg>)."
    echo "To force a fresh session: close that tab first (herdr tab close), then re-run."
    exit 0
  fi
  STATE_F="$STATE_FILE"
  RUNNER="claude"
  [[ -f "$STATE_F" ]] && RUNNER="$(jq -r '.runner // "claude"' "$STATE_F" 2>/dev/null)"
  [[ -n "$RUNNER_FLAG" ]] && RUNNER="$RUNNER_FLAG"
  if [[ -f "$STATE_F" ]]; then
    jq --arg p "$P0" --arg r "$RUNNER" '.herdr = (.herdr // {}) + {pane: $p} | .runner = $r' "$STATE_F" > "$STATE_F.tmp" && mv "$STATE_F.tmp" "$STATE_F"
  fi
  STOPPED_NOTE="terminal-notifier -title 'shield' -message 'Agent stopped: $NAME' -sound default -group shield 2>/dev/null || true"
  if [[ "$RUNNER" == "claude" ]]; then
    mux pane-run --pane "$P0" --text "cd $(printf %q "$WORK_DIR") && claude --agent coordinator $PERM_FLAG --remote-control shield:$NAME -n shield:$NAME; $STOPPED_NOTE"
  else
    RESUME_PROMPT="Read $SHIELD_STATE_REL/playbook/workflow.md, then the plan in docs/plans/ for ticket $NAME and its Progress section; resume at the recorded stage and round — do not restart. Keep Progress updated."
    [[ "$GOD" == "true" ]] && RESUME_PROMPT="$RESUME_PROMPT Autonomy: mode autonomous — no optional pauses."
    mux pane-run --pane "$P0" --text "cd $(printf %q "$WORK_DIR") && $RUNNER $(printf %q "$RESUME_PROMPT"); $STOPPED_NOTE"
  fi
fi
mux tab-focus --tab "$TAB_ID" >/dev/null 2>&1 || true

echo ""
echo "Stream '$NAME' resumed at stage '$FROM_STAGE'"
echo "  Project: $PROJECT_DIR"
echo "  Directory: $WORK_DIR"
echo "  Branch: $(git -C "$WORK_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null)"
echo "  Herdr tab: $TAB_ID"
