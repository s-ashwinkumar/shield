#!/usr/bin/env bash
# shield watch -- fleet watcher: turns stream state changes into attention items.
#
# Deterministic, zero-token. Scans every registered stream's (all projects)
# .claude/shield/state.json,
# diffs against a cache, and emits attention-item JSON files that the captain
# agent consumes. Also: batched wake-up injection into the coulson pane,
# dead-man fallback to terminal-notifier, heartbeat, auto-cancel of stale
# items.
#
# Modes / env:
#   SHIELD_WATCH_INTERVAL=15      scan every N seconds
#   SHIELD_WATCH_DEADMAN_MIN=10    unacked item age before raw notification
#   SHIELD_WATCH_SHADOW=1          write items only (no wake-ups, no dead-man)
#   SHIELD_WATCH_ONCE=1            single scan then exit (tests)
#   SHIELD_WATCH_NO_PANES=1        skip pane/agent checks (tests, no herdr)
#   SHIELD_WATCH_SCAN_DIR=PATH     override stream discovery with a fixture dir
#   SHIELD_WATCH_HOME=PATH   override ~/.shield/attention
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

INTERVAL="${SHIELD_WATCH_INTERVAL:-15}"
DEADMAN_MIN="${SHIELD_WATCH_DEADMAN_MIN:-10}"
SHADOW="${SHIELD_WATCH_SHADOW:-0}"
ONCE="${SHIELD_WATCH_ONCE:-0}"
NO_PANES="${SHIELD_WATCH_NO_PANES:-0}"
ATT="${SHIELD_WATCH_HOME:-${SHIELD_HOME:-$HOME/.shield}/attention}"

# --- Args: this is a DAEMON. Bare invocation starts the loop; give agents
# and humans safe entry points that always terminate.
case "${1:-}" in
  -h|--help)
    cat <<'EOF_USAGE'
shield watch — fleet watcher daemon (normally managed by launchd via shield coulson).

  shield watch [status]  heartbeat, pid, queue counts (safe, read-only, exits)
  shield watch daemon    start the daemon loop (refuses if one is already alive)
  env: SHIELD_WATCH_INTERVAL SHIELD_WATCH_DEADMAN_MIN SHIELD_WATCH_SHADOW SHIELD_WATCH_ONCE SHIELD_WATCH_NO_PANES
       SHIELD_WATCH_SCAN_DIR SHIELD_WATCH_HOME SHIELD_WATCH_ADOPT_SEC
EOF_USAGE
    exit 0 ;;
  status)
    hb="none"; [[ -f "$ATT/heartbeat" ]] && hb="$(( $(date +%s) - $(stat -f %m "$ATT/heartbeat") ))s ago"
    pid="none"; [[ -f "$ATT/watch.pid" ]] && pid=$(cat "$ATT/watch.pid") && ! kill -0 "$pid" 2>/dev/null && pid="$pid (dead)"
    echo "shield watch: pid=$pid heartbeat=$hb pending=$(ls "$ATT/pending" 2>/dev/null | grep -c json) acked=$(ls "$ATT/acked" 2>/dev/null | grep -c json)"
    exit 0 ;;
  daemon) : ;;  # explicit daemon start (launchd uses this)
  "")
    if [[ "${SHIELD_WATCH_ONCE:-0}" != "1" ]]; then
      # SAFE DEFAULT: bare shield watch = status, never an accidental daemon.
      hb="none"; [[ -f "$ATT/heartbeat" ]] && hb="$(( $(date +%s) - $(stat -f %m "$ATT/heartbeat") ))s ago"
      pid="none"; [[ -f "$ATT/watch.pid" ]] && pid=$(cat "$ATT/watch.pid") && ! kill -0 "$pid" 2>/dev/null && pid="$pid (dead)"
      echo "shield watch: pid=$pid heartbeat=$hb pending=$(ls "$ATT/pending" 2>/dev/null | grep -c json) acked=$(ls "$ATT/acked" 2>/dev/null | grep -c json)"
      echo "shield watch: (this was 'status' — the watcher loop only starts via 'shield watch daemon', normally launchd)"
      exit 0
    fi ;;
  *) echo "shield watch: unknown arg '$1' (try: shield watch status | shield watch --help)" >&2; exit 2 ;;
esac

# Singleton: never start a second daemon next to a live one.
if [[ -f "$ATT/watch.pid" ]] && kill -0 "$(cat "$ATT/watch.pid")" 2>/dev/null \
   && [[ "$$" != "$(cat "$ATT/watch.pid")" ]] && [[ "${SHIELD_WATCH_ONCE:-0}" != "1" ]]; then
  echo "shield watch: already running (pid $(cat "$ATT/watch.pid")). Use 'shield watch status'." >&2
  exit 1
fi

mkdir -p "$ATT/pending" "$ATT/acked" "$ATT/done" "$ATT/.cache"
echo $$ > "$ATT/watch.pid"

# Stream discovery: a fixture dir of <stream>/ work dirs (tests), else the
# stream registry (~/.shield/streams), which spans every project.
source "$SCRIPT_DIR/_lib.sh"
set +e  # _lib.sh enables -e at source time; a watcher must outlive failed probes
SCAN_DIR="${SHIELD_WATCH_SCAN_DIR:-}"

# stream_dir <name> — the stream's work dir
stream_dir() {
  if [[ -n "$SCAN_DIR" ]]; then echo "$SCAN_DIR/$1"; else shield_stream_dir "$1"; fi
}
# stream_names — every stream to scan
stream_names() {
  local d
  if [[ -n "$SCAN_DIR" ]]; then
    for d in "$SCAN_DIR"/*/; do [[ -d "$d" ]] && basename "$d"; done
  else
    shield_stream_names
  fi
  return 0
}

# Patterns meaning the agent is waiting on a human
STUCK_PATTERNS=(
  "Allow once" "Allow always" "Do you want to proceed"
  "Press Enter to continue" "What should Claude do" "Interrupted"
  "\[Y/n\]" "\[y/N\]" "Permission requested"
)
STUCK_RE=$(printf "|%s" "${STUCK_PATTERNS[@]}"); STUCK_RE="${STUCK_RE:1}"

log() { echo "shield watch: $*"; }

# emit <stream> <type> <summary> <state_file>
# Dedupe: skip if a pending item for the same stream+type already exists.
emit() {
  local stream="$1" type="$2" summary="$3" state_file="$4"
  if ls "$ATT/pending/${stream}--${type}--"*.json >/dev/null 2>&1; then
    return 0
  fi
  local now; now=$(date +%s)
  local id="${stream}--${type}--${now}"
  jq -n --arg id "$id" --arg stream "$stream" --arg type "$type" \
        --arg summary "$summary" --argjson now "$now" \
        --argjson deadman "$DEADMAN_MIN" \
        --slurpfile st <(jq '{stage, ticket, project, demo_required, pr_url} | with_entries(select(.value != null))' "$state_file" 2>/dev/null || echo '{}') \
        '{id:$id, stream:$stream, type:$type, summary:$summary,
          created_at:$now, acked_at:null, escalated_raw:false,
          deadman_after_min:$deadman, state_snapshot:($st[0] // {})}' \
        > "$ATT/pending/${id}.json"
  NEW_ITEMS+=("$id")
  log "item: $id — $summary"
}

# already_surfaced <stream> <type> <summary>
# True if we already surfaced this stream+type with an IDENTICAL summary that the
# captain has seen (acked/) or that was resolved (done/). Guards against coordinator
# flags that re-bump attention.ts with no material change ("still waiting…"), which
# would otherwise re-emit every scan cycle and churn the queue.
already_surfaced() {
  local stream="$1" type="$2" summary="$3" d f prev
  for d in acked done; do
    for f in "$ATT/$d/${stream}--${type}--"*.json; do
      [[ -f "$f" ]] || continue
      prev=$(jq -r '.summary // ""' "$f" 2>/dev/null)
      [[ "$prev" == "$summary" ]] && return 0
    done
  done
  return 1
}

# cancel <pending-file> <reason>
cancel() {
  local f="$1" reason="$2" base
  base=$(basename "$f")
  jq --arg r "$reason" '.outcome = $r' "$f" > "$f.tmp" && mv "$f.tmp" "$ATT/done/$base"
  rm -f "$f"
  log "superseded: $base ($reason)"
}

scan_stream() {
  local stream="$1"
  local wt state cache
  wt="$(stream_dir "$stream")"
  state="$wt/$SHIELD_STATE_REL/state.json"
  [[ -f "$state" ]] || return 0
  cache="$ATT/.cache/${stream}.json"

  # First sight of a stream = BASELINE, not events: adopt the current state
  # silently unless it changed recently (a genuinely-waiting gate). Prevents
  # watcher (re)starts from backfilling attention items for historical
  # worktrees (done long ago, dead sessions, stale gates).
  if [[ ! -f "$cache" ]]; then
    local state_age=$(( $(date +%s) - $(stat -f %m "$state" 2>/dev/null || echo 0) ))
    if (( state_age > ${SHIELD_WATCH_ADOPT_SEC:-3600} )); then
      cp "$state" "$cache" 2>/dev/null || true
      log "adopted (baseline, state ${state_age}s old): $stream"
      return 0
    fi
  fi

  local cur_stage prev_stage ticket
  cur_stage=$(jq -r '.stage // ""' "$state" 2>/dev/null) || return 0
  prev_stage=$(jq -r '.stage // ""' "$cache" 2>/dev/null || echo "__none__")
  ticket=$(jq -r '.ticket // ""' "$state")

  # 1) Stage transitions
  # NOTE: plan_gate is intentionally NOT emitted on entry into the plan stage.
  # Streams are born with stage=plan (see shield_init_state_at), so an entry-based
  # gate fires at launch, before any plan exists. The coordinator raises the
  # gate itself via `shield gate` (state.attention) once the plan is ready — handled
  # by the coordinator-flagged attention path below.
  if [[ "$cur_stage" == "done" && "$prev_stage" != "done" ]]; then
    local demo extra=""
    demo=$(jq -r '.demo_required // false' "$state")
    [[ "$demo" == "true" ]] && extra=" — demo needed"
    emit "$stream" "done_followups" "Stream done (${ticket:-$stream})${extra}" "$state"
  fi

  # 2) Coordinator-flagged attention (state.attention = {type, summary, ts})
  local att_ts prev_att_ts
  att_ts=$(jq -r '.attention.ts // ""' "$state")
  prev_att_ts=$(jq -r '.attention.ts // ""' "$cache" 2>/dev/null || echo "")
  if [[ -n "$att_ts" && "$att_ts" != "$prev_att_ts" ]]; then
    local att_type att_summary full_summary
    att_type=$(jq -r '.attention.type // "blocked"' "$state")
    att_summary=$(jq -r '.attention.summary // "stream needs attention"' "$state")
    full_summary="$att_summary (${ticket:-$stream})"
    # Skip if the coordinator just re-bumped the flag ts with an unchanged summary.
    if ! already_surfaced "$stream" "$att_type" "$full_summary"; then
      emit "$stream" "$att_type" "$full_summary" "$state"
    fi
  fi

  # 3) Liveness + stuck prompts (needs herdr)
  if [[ "$NO_PANES" != "1" && "${REGISTRY_OK:-1}" == "1" && "$cur_stage" != "done" && -n "$cur_stage" ]]; then
    local agent_pane
    agent_pane=$(mux agent-cwd --cwd "$wt" 2>/dev/null || true)
    if [[ -z "$agent_pane" ]]; then
      # Not a live herdr agent.
      {
        # Only flag death for streams this watcher has seen ALIVE (marker),
        # or whose state changed recently — never for fossil worktrees. And
        # DEBOUNCE: agents blink out of the registry during turn transitions,
        # so require SHIELD_WATCH_DIED_MISSES consecutive missed polls (default 2).
        local st_age=$(( $(date +%s) - $(stat -f %m "$state" 2>/dev/null || echo 0) ))
        if [[ -f "$ATT/.cache/${stream}.alive" ]] || (( st_age < ${SHIELD_WATCH_ADOPT_SEC:-3600} )); then
          local misses=0 missf="$ATT/.cache/${stream}.misses"
          [[ -f "$missf" ]] && misses=$(cat "$missf")
          misses=$(( misses + 1 )); echo "$misses" > "$missf"
          if (( misses >= ${SHIELD_WATCH_DIED_MISSES:-2} )); then
            emit "$stream" "died" "Stream agent gone mid-pipeline (stage: $cur_stage)" "$state"
          fi
        fi
      }
    else
      touch "$ATT/.cache/${stream}.alive"
      rm -f "$ATT/.cache/${stream}.misses"
      local tail
      tail=$(mux pane-read --pane "$agent_pane" --lines 15 2>/dev/null || true)
      if [[ -n "$tail" ]] && echo "$tail" | grep -qE "$STUCK_RE"; then
        emit "$stream" "stuck" "Agent waiting on a prompt (stage: $cur_stage)" "$state"
      fi
    fi
  fi

  cp "$state" "$cache" 2>/dev/null || true
}

auto_cancel() {
  local f stream type wt state cur_stage att_ts
  for f in "$ATT/pending/"*.json; do
    [[ -f "$f" ]] || continue
    stream=$(jq -r '.stream' "$f"); type=$(jq -r '.type' "$f")
    wt="$(stream_dir "$stream")"; state="$wt/$SHIELD_STATE_REL/state.json"
    [[ -f "$state" ]] || continue
    cur_stage=$(jq -r '.stage // ""' "$state")
    case "$type" in
      plan_gate)  [[ "$cur_stage" != "plan" ]] && cancel "$f" "superseded" ;;
      died) # self-heal: agent back alive -> item is stale
            if [[ "$NO_PANES" != "1" && "${REGISTRY_OK:-1}" == "1" ]] && [[ -n "$(mux agent-cwd --cwd "$wt" 2>/dev/null || true)" ]]; then
              cancel "$f" "agent back alive"
            fi ;;
      stuck) : ;;  # cleared by ack; liveness re-emits if still true
      done_followups) : ;;
      *) # coordinator-flagged types: cancel when the flag was cleared
         att_ts=$(jq -r '.attention.ts // ""' "$state")
         [[ -z "$att_ts" ]] && cancel "$f" "superseded" ;;
    esac
  done
}

deadman() {
  [[ "$SHADOW" == "1" ]] && return 0
  local f now age summary stream
  now=$(date +%s)
  for f in "$ATT/pending/"*.json; do
    [[ -f "$f" ]] || continue
    [[ $(jq -r '.acked_at // ""' "$f") == "" ]] || continue
    [[ $(jq -r '.escalated_raw' "$f") == "false" ]] || continue
    age=$(( now - $(jq -r '.created_at' "$f") ))
    if (( age > DEADMAN_MIN * 60 )); then
      stream=$(jq -r '.stream' "$f"); summary=$(jq -r '.summary' "$f")
      "$SCRIPT_DIR/shield-notify" "$stream" "[unrouted] $summary" || true
      jq '.escalated_raw = true' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
      log "dead-man fired: $(basename "$f")"
    fi
  done
}

wakeup() {
  [[ "$SHADOW" == "1" || "$NO_PANES" == "1" ]] && return 0
  (( ${#NEW_ITEMS[@]} > 0 )) || return 0
  local pane msg
  local ctab
  ctab=$(mux tab-find --name coulson 2>/dev/null || true)
  pane=""
  [[ -n "$ctab" ]] && pane=$(mux agent-tab --tab "$ctab" 2>/dev/null || true)
  if [[ -z "$pane" ]]; then
    log "no captain pane — wake-up skipped (${#NEW_ITEMS[@]} item(s) pending; dead-man armed)"
    return 0
  fi
  msg="🔔 attention: ${#NEW_ITEMS[@]} new item(s): ${NEW_ITEMS[*]}. Work the queue at $ATT/pending/."
  mux pane-run --pane "$pane" --text "$msg" >/dev/null 2>&1 || \
    log "wake-up injection failed"
}

scan() {
  NEW_ITEMS=()
  # Registry probe: if herdr is unreachable/empty from THIS process, skip all
  # liveness logic this scan (absence of evidence != death) and say so once.
  REGISTRY_OK=1
  if [[ "$NO_PANES" != "1" ]]; then
    local nagents
    nagents=$(mux list 2>>"$ATT/probe.err" | jq -r '.result.agents | length' 2>>"$ATT/probe.err")
    if [[ -z "$nagents" || "$nagents" == "0" ]]; then
      REGISTRY_OK=0
      log "herdr registry unreachable/empty from watcher (agents=${nagents:-ERR}) — liveness skipped this scan"
    fi
  fi
  local name
  while IFS= read -r name; do
    [[ -n "$name" ]] && scan_stream "$name"
  done < <(stream_names)
  auto_cancel
  deadman
  wakeup
  touch "$ATT/heartbeat"
}

log "watching ${SCAN_DIR:-$SHIELD_STREAMS} every ${INTERVAL}s (shadow=$SHADOW, deadman=${DEADMAN_MIN}m, queue=$ATT)"
while true; do
  scan
  [[ "$ONCE" == "1" ]] && exit 0
  sleep "$INTERVAL"
done
