#!/usr/bin/env bash
# shield clean -- Tear down a workstream: worktree + Herdr tab

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/_lib.sh"
shield_load_config

usage() {
  cat <<EOF
Usage: shield clean <name> [--yes] [--force]

Clean up a workstream: remove the worktree and close the Herdr tab.
SAFE BY DEFAULT: refuses to remove a worktree with uncommitted changes or unpushed
commits (unless --force). Non-interactive with --yes (agents: always use --yes).

Arguments:
  name    Stream name (ticket ID)

Options:
  --yes, -y           Non-interactive: skip prompts, delete the merged branch
  --force             Remove even with uncommitted/unpushed work (destructive)
  -h, --help          Show this help
EOF
  exit 0
}

NAME=""
YES=false
FORCE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage ;;
    --yes|-y) YES=true; shift ;;
    --force) FORCE=true; shift ;;
    -*) echo "Unknown option: $1"; usage ;;
    *) NAME="$1"; shift ;;
  esac
done

if [[ -z "$NAME" ]]; then
  echo "Error: stream name required"
  usage
fi

shield_resolve_stream "$NAME"
STATE=$(shield_read_state "$NAME")
MODE=$(echo "$STATE" | jq -r '.mode // "worktree"')
BRANCH=$(git -C "$WORK_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "stream/$NAME")

# --- Safety: never silently destroy unlanded work (bypass with --force) ---
# A stream whose PR is MERGED is safe by definition (squash-merges won't match
# by SHA, so commit-counting would false-positive on the common case).
if [[ "$FORCE" != "true" && -d "$WORK_DIR" ]]; then
  PRNUM=$(echo "$STATE" | jq -r '.pr_number // empty')
  if [[ -n "$PRNUM" ]] && [[ "$(gh pr view "$PRNUM" --json state --jq .state 2>/dev/null)" == "MERGED" ]] \
     && [[ -z "$(git -C "$WORK_DIR" status --porcelain 2>/dev/null | head -1)" ]]; then
    echo "PR #$PRNUM is merged and the tree is clean — safe to remove."
    FORCE=true
  fi
fi
if [[ "$FORCE" != "true" && -d "$WORK_DIR" ]]; then
  UNSAFE=""
  if [[ -n "$(git -C "$WORK_DIR" status --porcelain 2>/dev/null | head -1)" ]]; then
    UNSAFE="uncommitted changes"
  else
    UPSTREAM=$(git -C "$WORK_DIR" rev-parse --abbrev-ref --symbolic-full-name "@{u}" 2>/dev/null || true)
    if [[ -n "$UPSTREAM" ]]; then
      AHEAD=$(git -C "$WORK_DIR" rev-list --count "@{u}..HEAD" 2>/dev/null || echo 0)
      (( AHEAD > 0 )) && UNSAFE="$AHEAD unpushed commit(s)"
    else
      # No upstream: unsafe only if the branch has commits not on the base
      # AND they aren't already merged (squash-merges won't match by SHA — the
      # caller should verify the PR merged and use --force, or push first).
      AHEAD=$(git -C "$WORK_DIR" rev-list --count "origin/$BASE_BRANCH..HEAD" 2>/dev/null || echo 0)
      (( AHEAD > 0 )) && UNSAFE="$AHEAD commit(s) not on origin/$BASE_BRANCH (branch never pushed)"
    fi
  fi
  if [[ -n "$UNSAFE" ]]; then
    echo "shield clean: REFUSING to remove '$NAME' — $UNSAFE in $WORK_DIR"
    echo "shield clean: push/land the work first, or re-run with --force if it is truly disposable"
    echo "shield clean: (squash-merged PRs: verify merged with 'gh pr view', then --force is safe)"
    exit 1
  fi
fi

# Close the Herdr tab for this stream.
WS_ID="$(mux space-find --name "$WORKSPACE")"
if [[ -n "$WS_ID" ]]; then
  TAB_ID="$(mux tab-find --name "$NAME" --workspace "$WS_ID")"
  if [[ -n "$TAB_ID" ]]; then
    echo "Closing Herdr tab '$NAME' ($TAB_ID)..."
    mux kill --tab "$TAB_ID" >/dev/null 2>&1 || true
  else
    echo "No Herdr tab labeled '$NAME' in workspace '$WORKSPACE' (already closed?)."
  fi
fi

if [[ "$MODE" == "local" ]]; then
  # Local mode: just remove shield's state and agent copies (repo agents stay)
  echo "Cleaning up local stream state..."
  rm -rf "${PROJECT_DIR:?}/$SHIELD_STATE_REL"
  shield_remove_agents "$PROJECT_DIR"
  shield_unregister_stream "$NAME"
  echo "Stream '$NAME' cleaned up (local mode)."
  echo "Branch '$BRANCH' is still checked out — switch manually if needed."
else
  # Worktree mode: remove worktree
  WORKTREE_PATH="$WORK_DIR"
  if [[ -d "$WORKTREE_PATH" ]]; then
    echo "Removing worktree at $WORKTREE_PATH..."
    git -C "$PROJECT_DIR" worktree remove "$WORKTREE_PATH" --force 2>/dev/null || {
      echo "git worktree remove failed, force-removing directory..."
      rm -rf "$WORKTREE_PATH"
    }
    git -C "$PROJECT_DIR" worktree prune 2>/dev/null
  else
    # Directory gone but git might still track it — prune stale entries
    git -C "$PROJECT_DIR" worktree prune 2>/dev/null
    echo "Worktree '$NAME' not found at $WORKTREE_PATH (pruned stale references)"
  fi

  # Delete branch (auto with --yes; prompt otherwise)
  if git -C "$PROJECT_DIR" show-ref --verify --quiet "refs/heads/$BRANCH" 2>/dev/null; then
    if [[ "$YES" == "true" ]]; then
      git -C "$PROJECT_DIR" branch -D "$BRANCH"
      echo "Branch '$BRANCH' deleted."
    else
      read -rp "Delete branch '$BRANCH'? [y/N] " del_branch
      if [[ "$del_branch" == [yY] ]]; then
        git -C "$PROJECT_DIR" branch -D "$BRANCH"
        echo "Branch '$BRANCH' deleted."
      fi
    fi
  fi

  shield_unregister_stream "$NAME"
  echo "Stream '$NAME' cleaned up."
fi
