#!/usr/bin/env bash
# shield notify -- S.H.I.E.L.D. notification whose CLICK focuses the stream's tab.
#   shield notify <stream> <message...>
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
[[ $# -lt 2 || "${1:-}" == "-h" ]] && { echo "Usage: shield notify <stream> <message...>"; exit 0; }
STREAM="$1"; shift
terminal-notifier -title "S.H.I.E.L.D." -subtitle "$STREAM" -message "$*" \
  -sound default -group "shield-$STREAM" \
  -execute "$SCRIPT_DIR/shield-focus '$STREAM'" 2>/dev/null || true
