#!/usr/bin/env bash
# shield sync-skills -- make shield's workflow skills available to Claude Code sessions.
#
# Model (two layers): the workflow prefers skills the project repo already
# provides; shield only fills the GAP — the skills the repo doesn't have.
# Installs FLAT into ~/.claude/skills/<name>/ (the only layout Claude Code
# discovers as /name — nested ~/.claude/skills/shield/<name>/ is NOT discovered).
# Idempotent; safe to run on every stream create/resume.
#
#   shield sync-skills [<project-dir>]   (default: the repo you are in, if any)

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/_lib.sh"
shield_load_config

PROJECT_DIR="$(shield_project_root "${1:-$PWD}" 2>/dev/null || true)"

SRC="$SHIELD_ROOT/skills"
DST="$HOME/.claude/skills"
mkdir -p "$DST"

# skill name from SKILL.md frontmatter (falls back to dir name)
skill_name() { awk -F': *' '/^name:/{print $2; exit}' "$1/SKILL.md" 2>/dev/null; }

# does the project repo already provide a skill by this name? (use theirs if so)
project_has() {
  local want="$1" base d
  [[ -n "$PROJECT_DIR" ]] || return 1
  for base in "$PROJECT_DIR/.claude/skills" "$PROJECT_DIR/.agents/skills"; do
    [[ -d "$base" ]] || continue
    [[ -f "$base/$want/SKILL.md" ]] && return 0
    for d in "$base"/*/; do
      [[ -f "$d/SKILL.md" ]] || continue
      [[ "$(skill_name "$d")" == "$want" ]] && return 0
    done
  done
  return 1
}

[[ -d "$SRC" ]] || { echo "shield sync-skills: no $SRC — nothing to do"; exit 0; }

installed=() skipped=()
for d in "$SRC"/*/; do
  [[ -f "$d/SKILL.md" ]] || continue        # skip loose reference .md files
  dir="$(basename "$d")"
  name="$(skill_name "$d")"; name="${name:-$dir}"
  if project_has "$name"; then
    skipped+=("$name")
    continue
  fi
  rm -rf "${DST:?}/$dir"
  cp -R "$d" "$DST/$dir"
  installed+=("$name")
done

echo "shield sync-skills: installed [${installed[*]:-none}] flat in $DST; using the project's own for [${skipped[*]:-none}]"
