#!/usr/bin/env bash
# shield forward -- Advance pipeline past UX review to code review

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/_lib.sh"
shield_load_config

usage() {
  cat <<EOF
Usage: shield forward <name>

Advance the pipeline from UX review to code review. Tells the coordinator to start the review loop.

Arguments:
  name    Stream name (ticket ID)

Options:
  -h, --help          Show this help
EOF
  exit 0
}

NAME=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage ;;
    -*) echo "Unknown option: $1"; usage ;;
    *) NAME="$1"; shift ;;
  esac
done

if [[ -z "$NAME" ]]; then
  echo "Error: stream name required"
  usage
fi

shield_resolve_stream "$NAME"

# Read state — shield forward is flexible, works from any pre-done stage
STATE=$(shield_read_state "$NAME")
STAGE=$(echo "$STATE" | jq -r '.stage // "unknown"')
if [[ "$STAGE" == "done" ]]; then
  echo "Stream '$NAME' is already done."
  exit 0
fi

# Update state
shield_update_state "$NAME" "stage" "code_review"

# Check the Herdr tab exists
TAB_ID="$(shield_stream_tab "$NAME")"
if [[ -z "$TAB_ID" ]]; then
  echo "Error: Herdr tab '$NAME' not found. Start it first: shield stream $NAME"
  exit 1
fi

MAX_LOOPS=$(echo "$STATE" | jq -r '.max_review_loops // 3')

# Launch coordinator in review mode (new session with skip-permissions)
# The prompt argument is the initial user message — coordinator will act on it immediately
shield_coord_msg "$TAB_ID" "Start Stage 3: CODE REVIEW per the playbook and your fresh-eyes reviewer binding (diff vs $BASE_BRANCH). Fix Critical/Important findings with the builder and re-review, up to $MAX_LOOPS loops. Then continue through QA and Ship. Fully autonomous — no user gates."

echo "Code review started for '$NAME' (max $MAX_LOOPS loops)."
echo "You'll get a notification when the PR is ready."
