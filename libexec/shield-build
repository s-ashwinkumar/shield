#!/usr/bin/env bash
# shield build -- Approve plan and start autonomous build

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/_lib.sh"
shield_load_config

usage() {
  cat <<EOF
Usage: shield build <name>

Approve the plan and tell the coordinator to start building autonomously.

Arguments:
  name    Stream name (ticket ID)

Options:
  -h, --help          Show this help
EOF
  exit 0
}

NAME=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage ;;
    -*) echo "Unknown option: $1"; usage ;;
    *) NAME="$1"; shift ;;
  esac
done

if [[ -z "$NAME" ]]; then
  echo "Error: stream name required"
  usage
fi

shield_resolve_stream "$NAME"

# Validate state
STAGE=$(shield_get_stage "$NAME")
if [[ "$STAGE" != "plan" ]]; then
  echo "Error: stream '$NAME' is in stage '$STAGE', expected 'plan'"
  echo "shield build can only be run after planning is complete."
  exit 1
fi

# Check the Herdr tab exists
TAB_ID="$(shield_stream_tab "$NAME")"
if [[ -z "$TAB_ID" ]]; then
  echo "Error: Herdr tab '$NAME' not found. Start it first: shield stream $NAME"
  exit 1
fi

# Update state
shield_update_state "$NAME" "stage" "build"

# Message the LIVE coordinator (mid-planning) to start building; Herdr shows blocked if it prompts.
shield_coord_msg "$TAB_ID" "Plan approved. Start building. Read the plan from docs/plans/ and implement it with the builder subagent. When done, update .claude/shield/state.json stage to ux_review."

echo "Build started for '$NAME'."
echo "You'll get a notification when it's done."
