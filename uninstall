#!/usr/bin/env bash
# shield uninstall -- Clean removal of shield (leaves your repos and worktrees alone)
set -euo pipefail

SHIELD_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/shield"
SHIELD_HOME="${SHIELD_HOME:-$HOME/.shield}"
BIN_DIR="$HOME/.local/bin"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

ok()   { echo -e "  ${GREEN}✓${NC} $1"; }
warn() { echo -e "  ${YELLOW}!${NC} $1"; }
info() { echo -e "  ${BLUE}→${NC} $1"; }

echo ""
echo "shield -- Uninstall"
echo "==================="
echo ""

# ─── Stop the watcher service ────────────────────────────────────────────────

PLIST="$HOME/Library/LaunchAgents/com.shield.watch.plist"
if [[ -f "$PLIST" ]]; then
  launchctl bootout "gui/$(id -u)/com.shield.watch" 2>/dev/null || true
  rm -f "$PLIST"
  ok "Watcher service removed"
fi

# ─── Remove the command link ─────────────────────────────────────────────────

if [[ -L "$BIN_DIR/shield" ]]; then
  rm "$BIN_DIR/shield"
  ok "Removed $BIN_DIR/shield"
fi

# ─── Remove config ───────────────────────────────────────────────────────────

if [[ -d "$CONFIG_DIR" ]]; then
  info "Removing config directory: $CONFIG_DIR"
  rm -rf "$CONFIG_DIR"
  ok "Config removed"
else
  ok "Config directory not found (already clean)"
fi

# ─── Remove PATH entry ───────────────────────────────────────────────────────

SHELL_RC="$HOME/.zshrc"
if [[ "$(basename "$SHELL")" == "bash" ]]; then
  SHELL_RC="$HOME/.bashrc"
fi

if grep -q '# shield PATH' "$SHELL_RC" 2>/dev/null; then
  info "Removing PATH entry from $SHELL_RC"
  sed -i '' '/# shield PATH/d' "$SHELL_RC"
  sed -i '' "\|export PATH=\"$BIN_DIR:\\\$PATH\"|d" "$SHELL_RC"
  ok "PATH entry removed"
fi

# ─── Warnings ────────────────────────────────────────────────────────────────

echo ""

if ls "$SHIELD_HOME/streams" 2>/dev/null | grep -q .; then
  warn "Registered streams still exist (their worktrees are untouched):"
  for f in "$SHIELD_HOME"/streams/*; do
    [[ -f "$f" ]] && warn "  $(basename "$f") → $(cat "$f")"
  done
  warn "Clean them first with 'shield clean <stream>' if they're done."
fi
if [[ -d "$SHIELD_HOME" ]]; then
  warn "Runtime data kept at $SHIELD_HOME (attention queue, QA Chrome profile)."
  warn "Remove manually if no longer needed: rm -rf $SHIELD_HOME"
fi

echo ""
echo -e "${GREEN}shield uninstalled.${NC} (the checkout at $SHIELD_ROOT is untouched)"
echo ""
