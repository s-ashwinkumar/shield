#!/usr/bin/env bash
# rdev uninstall -- Clean removal of rdev
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rdev"
BIN_DIR="$HOME/.local/bin"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

ok()   { echo -e "  ${GREEN}✓${NC} $1"; }
warn() { echo -e "  ${YELLOW}!${NC} $1"; }
info() { echo -e "  ${BLUE}→${NC} $1"; }

echo ""
echo "rdev -- Uninstall"
echo "================="
echo ""

# ─── Remove symlinks ─────────────────────────────────────────────────────────

info "Removing script symlinks from $BIN_DIR"
for cmd in rdev rstream rbuild rpromote runpromote rforward rstatus rclean; do
  if [[ -L "$BIN_DIR/$cmd" ]]; then
    rm "$BIN_DIR/$cmd"
    ok "Removed $cmd"
  fi
done

# ─── Remove config ───────────────────────────────────────────────────────────

if [[ -d "$CONFIG_DIR" ]]; then
  info "Removing config directory: $CONFIG_DIR"
  rm -rf "$CONFIG_DIR"
  ok "Config removed"
else
  ok "Config directory not found (already clean)"
fi

# ─── Remove tmux config additions ────────────────────────────────────────────

TMUX_CONF="$HOME/.tmux.conf"
if [[ -f "$TMUX_CONF" ]] && grep -q '# --- rdev begin ---' "$TMUX_CONF"; then
  info "Removing tmux config additions from $TMUX_CONF"
  sed -i '' '/# --- rdev begin ---/,/# --- rdev end ---/d' "$TMUX_CONF"
  ok "tmux config cleaned"
else
  ok "No tmux config to remove"
fi

# ─── Remove PATH entry ───────────────────────────────────────────────────────

SHELL_RC="$HOME/.zshrc"
if [[ "$(basename "$SHELL")" == "bash" ]]; then
  SHELL_RC="$HOME/.bashrc"
fi

if grep -q '# rdev PATH' "$SHELL_RC" 2>/dev/null; then
  info "Removing PATH entry from $SHELL_RC"
  sed -i '' '/# rdev PATH/d' "$SHELL_RC"
  sed -i '' "\|export PATH=\"$BIN_DIR:\\\$PATH\"|d" "$SHELL_RC"
  ok "PATH entry removed"
fi

# ─── Warnings ────────────────────────────────────────────────────────────────

echo ""

# Check for worktrees
if [[ -f "$CONFIG_DIR/config" ]]; then
  # Config already removed, check common location
  :
fi

WORKTREE_DIRS=("$HOME/code/rhythms-worktrees" "$HOME/code/rhythms"-worktrees)
for wt_dir in "${WORKTREE_DIRS[@]}"; do
  if [[ -d "$wt_dir" ]]; then
    warn "Worktree directory still exists: $wt_dir"
    warn "Remove manually if no longer needed: rm -rf $wt_dir"
  fi
done


echo ""
echo -e "${GREEN}rdev uninstalled.${NC}"
echo ""
