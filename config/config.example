# shield global configuration (~/.config/shield/config)
# Generated by shield's install. Per-repo settings go in <repo>/.shield/config
# (see config/project.example).

# Where your git repos live. `shield -C <name>` resolves <name> under here.
PROJECTS_ROOT="{projects_root}"

# Optional: the project to use when you're not inside a git repo.
DEFAULT_PROJECT="{default_project}"

# Notifications (terminal-notifier)
NOTIFY=true

# Pipeline defaults
MAX_REVIEW_LOOPS=3
SHIELD_RUNNER=claude

# App to bring forward when a notification is clicked (e.g. "Ghostty", "iTerm")
SHIELD_TERMINAL_APP=""
